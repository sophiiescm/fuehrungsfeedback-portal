# Kopieren nach .env und Werte anpassen. Keine echten Secrets committen.

APP_ENV=dev

# --- PostgreSQL (Portal-Daten) ---
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://portal:portal_dev_password@postgres:5432/portal

# --- MariaDB (LimeSurvey-eigene DB) ---
MARIADB_DATABASE=limesurvey
MARIADB_USER=limesurvey
MARIADB_PASSWORD=limesurvey_dev_password
MARIADB_ROOT_PASSWORD=limesurvey_root_dev_password

# --- LimeSurvey ---
LIMESURVEY_ADMIN_USER=admin
LIMESURVEY_ADMIN_PASSWORD=admin_dev_password
LIMESURVEY_ADMIN_NAME=Portal Admin
LIMESURVEY_ADMIN_EMAIL=admin@example.test
LIMESURVEY_URL=http://localhost:8080
LIMESURVEY_RC_API_URL=http://limesurvey:8080/index.php/admin/remotecontrol
# Technischer API-User fuer RemoteControl (separat vom Admin-Login anlegen, Rechte einschraenken)
LIMESURVEY_RC_USER=portal_api
LIMESURVEY_RC_PASSWORD=change_me_dev_password

# --- Mailpit (lokaler SMTP-Fang) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=feedback-portal@example.test
MAILPIT_WEB_PORT=8025

# --- Portal-API ---
PORTAL_API_PORT=8000
SECRET_KEY=change_me_dev_secret_key_please_rotate
FEEDBACKBRIDGE_HMAC_SECRET=change_me_dev_hmac_secret

# --- OIDC SSO (optional, per ENV aktivierbar) ---
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:5173/auth/callback

# --- KI-Zusammenfassung (Provider austauschbar) ---
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Portal-Web ---
PORTAL_WEB_PORT=5173
PUBLIC_API_BASE_URL=http://localhost:8000
